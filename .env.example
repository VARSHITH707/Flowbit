# VoiceType needs NO credentials, accounts or API keys. Nothing here is required.
# These are optional environment variables; copy to .env only if you want to change a default.

# Where settings, history, memory and the log are stored (default: userdata\ inside the VoiceType folder)
# VOICETYPE_HOME=D:\VoiceTypeData

# Speech models are stored in models\ inside the VoiceType folder.

# Hide the harmless Windows "symlinks not supported" warning from the model downloader
# HF_HUB_DISABLE_SYMLINKS_WARNING=1

# Force fully offline mode (never contact Hugging Face; the model must already be downloaded)
# HF_HUB_OFFLINE=1
